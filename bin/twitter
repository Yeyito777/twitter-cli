#!/usr/bin/env bash
# Twitter CLI — terminal client for X/Twitter.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
PYTHON="$PROJECT_DIR/.venv/bin/python3"

export PYTHONPATH="$PROJECT_DIR"

usage() {
    cat <<'EOF'
usage: twitter [-a ALIAS] <command> [args]

commands:
  Reading:
    timeline, tl         Home feed (--latest for chronological)
    tweet <id_or_url>    View a single tweet
    search, s <query>    Search tweets
    profile, p <@user>   View a user's profile
    tweets <@user>       View a user's tweets (--replies)
    thread <id_or_url>   View a full thread/conversation
    notifications, notif Recent notifications
    bookmarks, bms       List bookmarked tweets
    trending             Trending topics
    dms                  List DM conversations
    dm <@user_or_id>     Read a DM, or send exact stdin text with --send

  Posting:
    post                 Post exact stdin text (--reply, --quote)
    reply <tweet>        Reply using exact stdin text
    delete <id_or_url>   Delete one of your own tweets

  Engagement:
    like / unlike        Like or unlike a tweet
    rt / unrt            Retweet or undo a retweet
    bookmark, bm         Bookmark a tweet
    unbookmark, ubm      Remove a bookmark
    follow / unfollow    Follow or unfollow a user
    mute / unmute        Mute or unmute a user
    block / unblock      Block or unblock a user

  Accounts:
    accounts             List configured accounts
    account              Manage named accounts (list, add, migrate, default, remove, unlock)
    login                Refresh an account's credentials (--from-vimbrowser, --stdin)
    logout               Remove an account's stored credentials

  Health:
    doctor               Check the browser identity and whether writes may run

  Notify:
    notify               Manage Exocortex reply/quote subscriptions
                         (subscribe, unsubscribe, list, mark, start, stop)

Accounts:
  Use 'twitter -a NAME <command>' or 'twitter <command> -a NAME ...' to pick an account.
  Reads use the default account; with several accounts, posts, engagement,
  DM sends, and notify changes require an explicit -a.

Payload input:
  post, reply, and dm --send read exact UTF-8 text from stdin.
  Inline message arguments are not accepted.

Run 'twitter <command> --help' for command-specific usage.
EOF
}

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

# Account selection is process-local. Accept it before or after the command.
account=""
account_explicit=0
take_account() {
    [[ $account_explicit -eq 0 ]] || { echo "twitter: account may only be selected once" >&2; exit 2; }
    [[ -n "$1" ]] || { echo "twitter: -a/--account requires an alias" >&2; exit 2; }
    account="$1"; account_explicit=1
}

args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --) args+=("$@"); break ;;
        -a|--account)
            [[ $# -ge 2 ]] || { echo "twitter: $1 requires an alias" >&2; exit 2; }
            take_account "$2"; shift 2 ;;
        --account=*) take_account "${1#*=}"; shift ;;
        *) args+=("$1"); shift ;;
    esac
done
set -- "${args[@]}"

if [[ $account_explicit -eq 1 ]]; then
    export TWITTER_ACCOUNT="$account" TWITTER_ACCOUNT_EXPLICIT=1
else
    unset TWITTER_ACCOUNT TWITTER_ACCOUNT_EXPLICIT
fi

[[ $# -gt 0 ]] || { usage; exit 1; }
cmd="$1"; shift

# Run a Python call after checking which account it acts as.
run() {
    local call="$1"; shift
    exec "$PYTHON" -c "import sys
from src.accounts import cli_preflight
from src.write_guard import WritePaused
cli_preflight(sys.argv[1], sys.argv[2:])
try:
    $call
except WritePaused as e:
    print(f'Error: {e}', file=sys.stderr)
    sys.exit(3)
except RuntimeError as e:
    print(f'Error: {e}', file=sys.stderr)
    sys.exit(1)" "$cmd" "$@"
}

# Resolve aliases
case "$cmd" in
    tl)    cmd="timeline" ;;
    s)     cmd="search" ;;
    p)     cmd="profile" ;;
    notif) cmd="notifications" ;;
    bms)   cmd="bookmarks" ;;
    bm)    cmd="bookmark" ;;
    ubm)   cmd="unbookmark" ;;
    setup|auth) cmd="login" ;;
esac

case "$cmd" in
    timeline|tweet|search|profile|tweets|thread|notifications|bookmarks|trending|dms|dm)
        run "from src.reading import $cmd; $cmd(sys.argv[2:])" "$@" ;;
    post|reply|delete)
        run "from src.posting import $cmd; $cmd(sys.argv[2:])" "$@" ;;
    like|unlike|rt|unrt|bookmark|unbookmark|follow|unfollow|mute|unmute|block|unblock)
        run "from src.engagement import $cmd; $cmd(sys.argv[2:])" "$@" ;;
    login|logout)
        run "from src.auth import $cmd; $cmd(sys.argv[2:])" "$@" ;;
    doctor)
        run "from src.doctor import doctor; doctor(sys.argv[2:])" "$@" ;;
    notify)
        run "from src.notify import dispatch; dispatch('notify', sys.argv[2:])" "$@" ;;
    accounts)
        exec "$PYTHON" -c "import sys; from src.accounts import cli_dispatch; cli_dispatch(['list'] + sys.argv[1:])" "$@" ;;
    account)
        exec "$PYTHON" -c "import sys; from src.accounts import cli_dispatch; cli_dispatch(sys.argv[1:])" "$@" ;;
    help|--help|-h)
        usage ;;
    *)
        echo "twitter: unknown command '$cmd'" >&2
        echo "Run 'twitter --help' for usage." >&2
        exit 1 ;;
esac
